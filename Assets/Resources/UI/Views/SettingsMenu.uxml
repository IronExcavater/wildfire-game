<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UI.UIElements">
    <ui:VisualElement name="menu-container">
        <ui:VisualElement class="row">
            <ui:Label text="Settings" class="h1 flex-grow" />
            <ui:Button name="back-button" text="Back" />
        </ui:VisualElement>
        <ui:ScrollView>
            <ui:Label text="Audio Settings" class="h2" />
            <uie:ExtendedSlider class="slider" name="master-volume-slider" label="Master" />
            <uie:ExtendedSlider class="slider" name="music-volume-slider" label="Music" />
            <uie:ExtendedSlider class="slider" name="sfx-volume-slider" label="Sfx" />
            
            <ui:Label text="Camera Settings" class="h2" />
            <ui:Toggle name="invert-pan-toggle" label="Invert Pan" />
            <ui:Toggle name="invert-rotate-toggle" label="Invert Rotate" />
            <ui:Toggle name="invert-zoom-toggle" label="Invert Zoom" />
            <uie:ExtendedSlider class="slider" name="pan-speed-slider" label="Pan Speed" />
            <uie:ExtendedSlider class="slider" name="rotate-speed-slider" label="Rotate Speed" />
            <uie:ExtendedSlider class="slider" name="zoom-speed-slider" label="Zoom Speed" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>