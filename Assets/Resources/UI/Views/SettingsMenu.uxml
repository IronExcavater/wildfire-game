<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns="UnityEngine.UIElements">
    <ui:VisualElement name="menu-container">
        <ui:Label text="Settings" />
        <ui:Label text="Volume" />
        <ui:SliderInt class="slider" name="volume-slider" low-value="0" high-value="100" />
        <ui:Label name="volume-value-label" text="50" />
        <ui:Toggle name="invert-pan-toggle" text="Invert Pan" />
        <ui:Button name="back-button" text="Back" />
    </ui:VisualElement>
</ui:UXML>